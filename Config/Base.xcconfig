// 全員共通の設定（Git 管理）。
// 自分だけの値（Team ID や Bundle ID）は Config/Local.xcconfig に書く（Git 管理外）。
// xcconfig では "//" がコメント扱いになるので、URL は https:/$()/... と書く。

BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =

// GitHub 上の最新店舗データ。main ブランチの shops.json を直接読む（公開リポジトリのみ）
SHOPS_DATA_URL =

// 設定画面に表示するリポジトリの URL
REPO_URL =

// ── iCloud 同期（訪問記録）─────────────────────────────
// 有料の Apple Developer Program のチームでビルドする前提で ON。
// 無料アカウントでビルドする人は Local.xcconfig で CODE_SIGN_ENTITLEMENTS = を空にする
// （その場合、訪問記録は端末内だけに保存される）。
CODE_SIGN_ENTITLEMENTS = SusuruMap/Resources/SusuruMap.entitlements
ICLOUD_CONTAINER = iCloud.$(BUNDLE_ID_PREFIX).susurumap

#include? "Local.xcconfig"
