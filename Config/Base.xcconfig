// 全員共通の設定（Git 管理）。
// 自分だけの値（Team ID や Bundle ID）は Config/Local.xcconfig に書く（Git 管理外）。
// xcconfig では "//" がコメント扱いになるので、URL は https:/$()/... と書く。

BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =

// GitHub 上の最新店舗データ。main ブランチの shops.json を直接読む（公開リポジトリのみ）
SHOPS_DATA_URL =

// 設定画面に表示するリポジトリの URL
REPO_URL =

// iCloud 同期を使う場合のコンテナ ID（例: iCloud.com.yourname.susurumap）
ICLOUD_CONTAINER =

#include? "Local.xcconfig"
