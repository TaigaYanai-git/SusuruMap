// このファイルを Config/Local.xcconfig にコピーして自分の値を入れる（Git には上がらない）
//   cp Config/Local.xcconfig.example Config/Local.xcconfig

// Xcode > Settings > Accounts で確認できる Team ID（Developer Program のチーム）
DEVELOPMENT_TEAM = XXXXXXXXXX

// Bundle ID の接頭辞。TestFlight 配布用はオーナーの値に揃える。
// 友達が自分のアカウントで実機ビルドする場合は各自ユニークな値にする。
BUNDLE_ID_PREFIX = com.yourname

// 無料アカウントでビルドする場合だけコメントを外す（iCloud 同期なしになる）
// CODE_SIGN_ENTITLEMENTS =
